  if (RETRYABLE.test(msg)) return "retryable";
  return "retryable";
}
function hasImage(ctx: Context): boolean {
  for (const m of (ctx as any).messages ?? []) {
    const c = (m as any).content;
    if (Array.isArray(c) && c.some((x: any) => x?.type === "image")) return true;
  }
  return false;
}
function resolveKey(spec: string | undefined): string | undefined {
  if (!spec) return undefined;
  if (spec.startsWith("$")) {
    const name = spec.slice(1).replace(/^\{|\}$/g, "");
    return process.env[name];
  }
