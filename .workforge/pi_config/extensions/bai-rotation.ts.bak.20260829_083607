      const candidates = buildCandidates(model);
      const imagePresent = hasImage(ctx);
      let lastError = "";
      let lastCat: string | undefined;
      const attempted: string[] = [];
      for (const cand of candidates) {
        const key = cand.provider + "/" + cand.id;
        if (!cooldown.isAvailable(key)) continue;
        if (imagePresent && !(cand as any).input?.includes?.("image")) {
          if (!reportedSkip.has(key)) { reportedSkip.add(key); try { (pi as any).appendEntry?.("bai_rotation_skip", { provider: cand.provider, model: cand.id, reason: "image_input_not_supported" }); } catch {} }
          continue;
        }
        // resolve apiKey for candidate (primary uses its own model apiKey via opts/apiKey if provided)
        const isPrimary = cand.provider === model.provider && cand.id === model.id;
        let apiKey: string | undefined;
        if (isPrimary) {
          apiKey = (opts as any)?.apiKey ?? resolveKey("$B_AI_API_KEY") ?? process.env.B_AI_API_KEY;
          if (!apiKey) apiKey = (cand as any).apiKey ?? "";
        } else {
          const route = PROVIDERS.find(p => p.name === cand.provider);
          // 1) Native Pi credential (auth.json / !command / $ENV) via ModelRuntime
          nativeAuth = nativeAuth ?? getNativeAuth();
          if (route?.authProvider && nativeAuth) {
            try {
              const auth = await nativeAuth.getAuth(route.authProvider);
              if (auth?.auth?.apiKey) apiKey = auth.auth.apiKey;
            } catch { /* fall through to env spec */ }
