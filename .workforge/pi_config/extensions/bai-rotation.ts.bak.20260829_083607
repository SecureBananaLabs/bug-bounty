        const msg = "bai-rotation: no candidate available (all in cooldown or auth missing)";
        try { (outer as any).push({ type: "error", reason: "error", error: { role: "assistant", content: [{ type: "text", text: msg }], api: model.api, provider: model.provider, model: model.id, stopReason: "error", errorMessage: msg } } as any); } catch {}
        (outer as any).end?.(); return;
      }
      const finalMsg = "bai-rotation: all candidates failed; last=" + lastError.slice(0, 400);
      try { (outer as any).push({ type: "error", reason: "error", error: { role: "assistant", content: [{ type: "text", text: finalMsg }], api: model.api, provider: model.provider, model: model.id, stopReason: "error", errorMessage: finalMsg } } as any); } catch {}
      (outer as any).end?.();
    })().catch((e: any) => {
      try { (outer as any).push({ type: "error", reason: "error", error: { role: "assistant", content: [{ type: "text", text: String(e?.message ?? e) }], api: model.api, provider: model.provider, model: model.id, stopReason: "error", errorMessage: String(e?.message ?? e) } } as any); (outer as any).end?.(); } catch {}
    });
