          if (!reportedSkip.has(key)) { reportedSkip.add(key); try { (pi as any).appendEntry?.("bai_rotation_skip", { provider: cand.provider, model: cand.id, reason: "auth_not_configured" }); } catch {} console.error("[bai-rotation] skip " + key + " auth_not_configured"); }
