}
const PROVIDERS: Array<{ name: string; baseUrl?: string; api?: string; apiKeySpec?: string; authProvider?: string; disabled?: boolean; models: Array<{ id: string; name: string; api?: string; reasoning: boolean; input: ("text"|"image")[]; contextWindow: number; maxTokens: number; cost: typeof ZERO; compat?: any }> }> = [
  { name: "gemini-failover", authProvider: "google", baseUrl: "https://generativelanguage.googleapis.com/v1beta", api: "google-generative-ai", apiKeySpec: "$GEMINI_API_KEY", models: [{ id: "gemini-3.5-flash-lite", name: "Gemini 3.5 Flash Lite (failover)", reasoning: false, input: ["text","image"], contextWindow: 1048576, maxTokens: 8192, cost: ZERO }] },
  { name: "groq-failover", authProvider: "groq", baseUrl: "https://api.groq.com/openai/v1", api: "openai-completions", apiKeySpec: "$GROQ_API_KEY", models: [{ id: "openai/gpt-oss-20b", name: "Groq gpt-oss-20b (failover)", reasoning: false, input: ["text"], contextWindow: 131072, maxTokens: 8192, cost: ZERO, compat: { supportsStore: false, supportsDeveloperRole: false } }] },
  { name: "cerebras-failover", authProvider: "cerebras", baseUrl: "https://api.cerebras.ai/v1", api: "openai-completions", apiKeySpec: "$CEREBRAS_API_KEY", disabled: true, models: [{ id: "gpt-oss-120b", name: "Cerebras gpt-oss-120b (failover)", reasoning: false, input: ["text"], contextWindow: 131072, maxTokens: 8192, cost: ZERO, compat: { supportsStore: false } }] },
  { name: "mistral-failover", authProvider: "mistral", baseUrl: "https://api.mistral.ai/v1", api: "mistral-conversations", apiKeySpec: "$MISTRAL_API_KEY", models: [{ id: "mistral-medium-3.5", name: "Mistral Medium 3.5 (failover)", reasoning: false, input: ["text","image"], contextWindow: 128000, maxTokens: 8192, cost: ZERO }] },
  { name: "vercel-failover", baseUrl: "https://ai-gateway.vercel.sh/v1", api: "openai-completions", apiKeySpec: "$VERCEL_API_KEY", models: [{ id: "poolside/laguna-s-2.1-free", name: "Vercel Laguna 2.1 Free (failover)", reasoning: false, input: ["text"], contextWindow: 131072, maxTokens: 8192, cost: ZERO }] },
  { name: "openrouter-failover", baseUrl: "https://openrouter.ai/api/v1", api: "openai-completions", apiKeySpec: "$OPENROUTER_API_KEY", models: [{ id: "openrouter/free", name: "OpenRouter Free Router (failover)", reasoning: false, input: ["text","image"], contextWindow: 200000, maxTokens: 4096, cost: ZERO }] },
];
const reportedSkip = new Set<string>();
// Lazy native credential resolver — created once on first failover dispatch.
// Mirrors pi's own auth-check runtime: no network model refresh, read-only auth usage.
let nativeAuth: any = null;
let nativeAuthTried = false;
function getNativeAuth(): any {
  if (nativeAuthTried) return nativeAuth;
  nativeAuthTried = true;
  // jiti aliases map @earendil-works/pi-coding-agent to pi's dist/index.js.
  // import() through the alias resolves the package entry (async; the resolver
  // object is picked up on a later failover dispatch once creation completes).
  import("@earendil-works/pi-coding-agent")
    .then((m: any) => m.ModelRuntime.create({ allowModelNetwork: false, refreshOnCreate: false }))
    .then((rt: any) => { nativeAuth = rt; })
    .catch((e: any) => { console.error("[bai-rotation] native auth unavailable:", String(e?.message ?? e).slice(0, 100)); nativeAuth = null; });
  return nativeAuth;
}
function buildCandidates(primary: Model<any>): Model<any>[] {
  const out: Model<any>[] = [primary];
  for (const p of PROVIDERS) {
    if (p.disabled) continue;
    for (const m of p.models) {
      out.push({ provider: p.name, id: m.id, api: (m.api ?? p.api) as Api, baseUrl: p.baseUrl, name: m.name, reasoning: m.reasoning, input: m.input, contextWindow: m.contextWindow, maxTokens: m.maxTokens, cost: ZERO, compat: (m as any).compat } as any);
