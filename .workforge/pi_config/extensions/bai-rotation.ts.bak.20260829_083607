/**
 * B.AI rotation — internal free-provider failover behind (b-ai) glm-5.3-flash.
 * Direct API dispatch (no ModelRuntime dependency).
 */
import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
import type { AssistantMessageEventStream, Context, Model, SimpleStreamOptions } from "@earendil-works/pi-ai";

type Api = Model<any>["api"];
const ZERO = { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 };

class Cooldown {
