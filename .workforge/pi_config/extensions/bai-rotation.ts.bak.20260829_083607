}
async function getApiModule(api: string): Promise<any> {
  const path = require("path");
  const base = path.dirname(require.resolve("@earendil-works/pi-ai"));
  const map: Record<string, string> = {
    "openai-completions": path.join(base, "api/openai-completions.js"),
    "anthropic-messages": path.join(base, "api/anthropic-messages.js"),
    "google-generative-ai": path.join(base, "api/google-generative-ai.js"),
    "mistral-conversations": path.join(base, "api/mistral-conversations.js"),
  };
  const p = map[api] ?? map["openai-completions"];
  return await import(p);
}
export default function(pi: ExtensionAPI) {
  for (const p of PROVIDERS) {
    if (p.disabled) continue;
    try { pi.registerProvider(p.name, { baseUrl: p.baseUrl, api: p.api as any, apiKey: p.apiKeySpec, models: p.models as any }); } catch (e) { console.error("[bai-rotation] register", p.name, (e as Error).message); }
  }
  const rotationStream = (model: Model<any>, ctx: Context, opts?: SimpleStreamOptions): AssistantMessageEventStream => {
    let outer: AssistantMessageEventStream;
    try {
      const piAi: any = require("@earendil-works/pi-ai");
      outer = piAi.createAssistantMessageEventStream();
    } catch (e) {
      console.error("[bai-rotation] outer stream create failed", (e as Error).message);
      outer = { push() {}, end() {}, [Symbol.asyncIterator]() { return { next: async () => ({ done: true, value: undefined }) }; } } as any;
    }
