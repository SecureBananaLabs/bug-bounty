+import test from "node:test";
+import assert from "node:assert/strict";
+import { createApp } from "../app.js";
+import { benchmarkApi } from "../utils/benchmark.js";

+test("benchmarkApi returns latency metrics, RPS, error rate and TTFB", async () => {
+  const app = createApp();
+  const server = app.listen(0);

+  await new Promise((resolve, reject) => {
+    server.once("listening", resolve);
+    server.once("error", reject);
+  });

+  const { port } = server.address();
+  const url = `http://127.0.0.1:${port}/health`;

+  const results = await benchmarkApi(url, { requests: 5, concurrency: 2 });

+  assert.equal(typeof results.p50, "number");
+  assert.equal(typeof results.p95, "number");
+  assert.equal(typeof results.p99, "number");
+  assert.equal(typeof results.rps, "number");
+  assert.equal(typeof results.errorRate, "number");
+  assert.equal(typeof results.ttfb, "number");
+  assert.equal(results.errorRate, 0);

+  await new Promise((resolve, reject) => {
+    server.close((error) => (error ? reject(error) : resolve()));
+  });
+});
