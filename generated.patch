+import { env } from "../config/env.js";

+export async function benchmarkApi(url, options = {}) {
+  const {
+    iterations = 10,
+    requests = iterations,
+    concurrency = 1,
+    method = "GET",
+    headers = {},
+    body = null
+  } = options;

+  let targetUrl = url;
+  if (typeof targetUrl === "string" && targetUrl.startsWith("/")) {
+    targetUrl = `http://127.0.0.1:${env.port || 4000}${targetUrl}`;
+  }

+  const totalRequests = requests;
+  const latencies = [];
+  const ttfbs = [];
+  let failedRequests = 0;

+  const startTime = performance.now();

+  const runRequest = async () => {
+    const reqStart = performance.now();
+    let ttfbVal = 0;
+    let isError = false;

+    try {
+      const fetchOpts = { method, headers };
+      if (body && method !== "GET" && method !== "HEAD") {
+        fetchOpts.body = typeof body === "object" ? JSON.stringify(body) : body;
+        if (typeof body === "object" && !headers["Content-Type"] && !headers["content-type"]) {
+          fetchOpts.headers = { ...headers, "Content-Type": "application/json" };
+        }
+      }

+      const res = await fetch(targetUrl, fetchOpts);
+      ttfbVal = performance.now() - reqStart;
+      await res.arrayBuffer();

+      if (!res.ok) {
+        isError = true;
+      }
+    } catch {
+      ttfbVal = performance.now() - reqStart;
+      isError = true;
+    }

+    const totalLatency = performance.now() - reqStart;

+    if (isError) {
+      failedRequests++;
+    }
+    latencies.push(totalLatency);
+    ttfbs.push(ttfbVal);
+  };

+  const queue = Array.from({ length: totalRequests }, () => runRequest);
+  const workers = Array.from({ length: Math.min(concurrency, totalRequests) }, async () => {
+    while (queue.length > 0) {
+      const task = queue.shift();
+      if (task) await task();
+    }
+  });

+  await Promise.all(workers);

+  const totalDurationMs = performance.now() - startTime;
+  const totalDurationSec = totalDurationMs / 1000 || 0.001;

+  latencies.sort((a, b) => a - b);
+  ttfbs.sort((a, b) => a - b);

+  const getPercentile = (arr, p) => {
+    if (arr.length === 0) return 0;
+    const idx = Math.min(arr.length - 1, Math.floor((p / 100) * arr.length));
+    return arr[idx];
+  };

+  const p50 = getPercentile(latencies, 50);
+  const p95 = getPercentile(latencies, 95);
+  const p99 = getPercentile(latencies, 99);

+  const avgTTFB = ttfbs.length > 0 ? ttfbs.reduce((a, b) => a + b, 0) / ttfbs.length : 0;
+  const p50TTFB = getPercentile(ttfbs, 50);

+  const rps = totalRequests / totalDurationSec;
+  const errorRate = totalRequests > 0 ? failedRequests / totalRequests : 0;

+  return {
+    p50,
+    p95,
+    p99,
+    rps,
+    errorRate,
+    ttfb: p50TTFB || avgTTFB,
+    p50Latency: p50,
+    p95Latency: p95,
+    p99Latency: p99,
+    requestsPerSecond: rps,
+    avgTTFB,
+    totalRequests,
+    successfulRequests: totalRequests - failedRequests,
+    failedRequests
+  };
+}