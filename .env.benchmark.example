# Blank target starts an isolated in-process API on loopback.
# Set a disposable local/staging server URL only when authorized to benchmark it.
BENCHMARK_TARGET_URL=

# All scenarios issue POST requests. Set to 1 only for disposable test data.
BENCHMARK_ALLOW_MUTATIONS=1

# Defaults are intentionally small. CI overrides duration/concurrency for smoke runs.
BENCHMARK_DURATION_SECONDS=5
BENCHMARK_CONCURRENCY=4
BENCHMARK_TIMEOUT_MS=5000
BENCHMARK_THRESHOLDS=benchmarks/thresholds.json
BENCHMARK_RESULTS_DIR=benchmarks/results

# The in-process API signs its own short-lived admin JWT using this local-only key.
# For a remote target, provide BENCHMARK_TOKEN or the target's JWT signing secret.
BENCHMARK_JWT_SECRET=local-benchmark-secret
BENCHMARK_USER_ID=benchmark-user-id
BENCHMARK_JOB_ID=benchmark-job-id
BENCHMARK_CATEGORY_ID=benchmark-category-id
BENCHMARK_EMAIL=benchmark@example.test
BENCHMARK_PASSWORD=benchmark-password-123
