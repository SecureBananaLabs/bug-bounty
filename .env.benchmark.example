# Copy to .env.benchmark (Node22+). Empty target starts an isolated local API.
BENCHMARK_TARGET=
# Dedicated test JWT required only when targeting your isolated staging server.
BENCHMARK_TOKEN=
# Explicit opt-in for a staging URL; never point this suite at production.
BENCHMARK_ALLOW_REMOTE=false
BENCHMARK_REQUESTS=10000
BENCHMARK_CONCURRENCY=4
BENCHMARK_TIMEOUT_MS=5000
