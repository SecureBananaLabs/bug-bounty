# Optional: copy to .env.benchmark. Requires Node 22+.
# A fresh real API process is started for each endpoint. Only loopback is allowed.
BENCH_HOST=127.0.0.1
# 0 chooses an available port; never target an existing application instance.
BENCH_PORT=0
BENCH_REQUESTS=1000
BENCH_WARMUP=20
BENCH_CONCURRENCY=4
BENCH_TIMEOUT_MS=5000
# Optional alternate reviewable gate file, relative to the repository root:
# BENCH_THRESHOLDS_PATH=benchmarks/thresholds.json
# Optional output directory (defaults to benchmarks/results):
# BENCH_RESULTS_DIR=benchmarks/results
# JWT secret/token are generated per fixture; do not put credentials here.
