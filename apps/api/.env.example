# Runtime mode: "development" or "production". Optional, defaults to "development".
NODE_ENV=development

# Port the Express API listens on. Optional, defaults to 4000.
PORT=4000

# Secret used to sign and verify access tokens. Required in any real deployment.
JWT_SECRET=development-secret

# Secret Stripe key used by the payments service. Required when payments are enabled.
STRIPE_SECRET_KEY=

# Connection string used by the Prisma client in packages/db. Required for persistence.
DATABASE_URL=
