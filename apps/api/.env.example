# Environment variables for the API workspace
# Copy this file to .env and update the values as needed

# Runtime mode (development, production, test)
# Defaults to development
NODE_ENV=development

# HTTP port the Express server listens on
# Defaults to 4000
PORT=4000

# Secret used to sign and verify JWTs
# Generate a strong secret for production
JWT_SECRET=your-super-secret-jwt-key-here

# Stripe secret key for payment processing
# Optional, required if using Stripe features
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Database connection string
# Optional, Prisma wiring is a placeholder today
DATABASE_URL="postgresql://username:password@host:port/database"