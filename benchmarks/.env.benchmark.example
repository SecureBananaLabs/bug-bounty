# Optional local benchmark overrides.
# Copy this file to .env.benchmark in the repository root.
# All values are commented so full and smoke modes keep their own defaults.
# CLI flags override these values; existing shell variables override this file.

# Local bind address only: 127.0.0.1, localhost, or ::1.
# The runner chooses an ephemeral port and starts the API itself.
# BENCHMARK_HOST=127.0.0.1

# Measured attempts per endpoint, integer 1..1000.
# Defaults: full 200, smoke 50. The default gate needs at least 30 samples.
# BENCHMARK_REQUESTS=50

# Maximum simultaneous requests: full 1..32, smoke 1 or 2.
# Defaults: full 4, smoke 1.
# BENCHMARK_CONCURRENCY=1

# Target starts per second, 0..2000. Zero disables pacing.
# Defaults: full 100, smoke 50. Concurrency always remains bounded.
# Positive rates must keep the full start schedule within 2147483647 ms.
# BENCHMARK_RATE=50

# Additional warmup requests after the mandatory preflight, integer 0..20.
# BENCHMARK_WARMUP=5

# Absolute deadline in milliseconds, integer 10..10000; default 1000.
# BENCHMARK_TIMEOUT_MS=1000

# Complete threshold file and output directory, relative to the repo root.
# The output directory receives latest.json and latest.md.
# BENCHMARK_THRESHOLDS=benchmarks/thresholds.json
# BENCHMARK_OUTPUT=benchmarks/results

# No JWT, password, database URL, payment key, or remote target is needed.
# The runner creates isolated credentials and synthetic fixtures in memory.
