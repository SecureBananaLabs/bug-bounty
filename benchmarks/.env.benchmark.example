# Copy this file to benchmarks/.env.benchmark and adjust the values.
#
# Leave BENCHMARK_BASE_URL empty to let the runner start apps/api locally on an
# ephemeral port (recommended for reproducible local numbers).
BENCHMARK_BASE_URL=

# Bearer token for auth-protected routes (currently GET /api/admin/metrics).
# Optional for local runs: when empty, the runner mints a short-lived token
# using BENCHMARK_JWT_SECRET, which must match the API's JWT_SECRET.
BENCHMARK_TOKEN=
BENCHMARK_JWT_SECRET=development-secret

# Load profile. CLI flags override these values.
BENCHMARK_CONNECTIONS=50
BENCHMARK_DURATION=10
BENCHMARK_PIPELINING=1
BENCHMARK_TTFB_SAMPLES=20
