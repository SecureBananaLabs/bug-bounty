# Copy this file to .env.benchmark and adjust values for your environment.
# The benchmark runner loads .env.benchmark automatically if present.

# Target host (no trailing slash). Local dev or staging.
BENCHMARK_HOST=http://localhost:3000

# Dedicated benchmark auth token. Must be a valid token for a test user
# with access to all /api/ routes being benchmarked. Do NOT use a real
# production user token.
BENCHMARK_TOKEN=replace-with-benchmark-test-token

# Optional: override the default duration (seconds) per endpoint.
# BENCHMARK_DURATION=10

# Optional: override the default connections (concurrency) per endpoint.
# BENCHMARK_CONNECTIONS=25

# Optional: override the smoke-mode duration/connections.
# BENCHMARK_SMOKE_DURATION=3
# BENCHMARK_SMOKE_CONNECTIONS=5

# Optional: path to thresholds file (defaults to ./thresholds.json).
# BENCHMARK_THRESHOLDS=./thresholds.json
