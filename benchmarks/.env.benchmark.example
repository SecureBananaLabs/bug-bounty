# Copy to repository root as .env.benchmark. Empty URL starts isolated loopback API.
BENCHMARK_SECONDS=2
BENCHMARK_CONCURRENCY=4
# Authorized disposable staging only: this suite WRITES data and uploads a file.
# BENCHMARK_URL=http://127.0.0.1:4000
# BENCHMARK_TOKEN= dedicated short-lived benchmark admin JWT
# BENCHMARK_ALLOW_WRITES=yes
