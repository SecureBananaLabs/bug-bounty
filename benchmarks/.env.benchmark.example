# Copy this file to .env.benchmark and adjust values for your environment.
# The benchmark runner loads .env.benchmark automatically.

# Target host (no trailing slash). Use a local or staging server.
BENCHMARK_HOST=http://localhost:3000

# Bearer token for auth-protected routes. Use a dedicated benchmark test token.
BENCHMARK_TOKEN=replace-with-benchmark-test-token

# Load profile
BENCHMARK_CONNECTIONS=50
BENCHMARK_DURATION=15
BENCHMARK_PIPELINING=1

# Smoke profile (used by CI)
BENCHMARK_SMOKE_CONNECTIONS=5
BENCHMARK_SMOKE_DURATION=5

# Output directory (relative to benchmarks/)
BENCHMARK_OUTPUT_DIR=results
