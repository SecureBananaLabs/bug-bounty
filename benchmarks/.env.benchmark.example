# Optional existing disposable local/staging API. Leave unset to start an
# isolated loopback API automatically. No production host or live token.
# BENCHMARK_HOST=http://127.0.0.1:4000
# BENCHMARK_ALLOW_MUTATIONS=1
# BENCHMARK_TOKEN=dedicated-benchmark-token
# BENCHMARK_REQUESTS=200
# BENCHMARK_CONCURRENCY=4
# BENCHMARK_TIMEOUT_MS=5000
