# Benchmark environment template.
#
# Copy to `.env.benchmark` and adjust. The harness reads these variables.
# `.env.benchmark` is gitignored; this template is committed.

# Benchmark an ALREADY-RUNNING server instead of spawning a child process.
# Leave empty/unset to have the harness boot the API itself on BENCH_PORT.
BENCH_TARGET_HOST=

# Port for the harness-spawned API child process (default 4010).
BENCH_PORT=4010

# Must match the API's JWT_SECRET so the admin route is exercised rather than
# short-circuited to 401. The app's dev default is "development-secret".
JWT_SECRET=development-secret

# The harness sets BENCHMARK_DISABLE_LIMITER=true for the child process so the
# rate limiter does not 429 every request at high concurrency. Only honoured
# when the API itself is started with it; never set in production.
BENCHMARK_DISABLE_LIMITER=true
