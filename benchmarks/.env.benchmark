# Benchmark template. Copy values into your shell or edit in place.
# Host the running API listens on (the runner boots its own server when unset).
BENCHMARK_HOST=127.0.0.1
# Concurrent connections per endpoint. Smoke runs in CI use 2.
BENCHMARK_CONNECTIONS=10
# Milliseconds per endpoint once warm-up requests complete.
BENCHMARK_DURATION_MS=1500
# Token used for auth-protected routes; a development JWT is generated when unset.
BENCHMARK_TOKEN=
