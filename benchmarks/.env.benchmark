# .env.benchmark — TEMPLATE ONLY (bug-bounty#30)
#
# Copy to a local untracked file and fill in real values:
#   cp benchmarks/.env.benchmark .env.benchmark.local
#
# NEVER commit real secrets. This template contains placeholders only.
# The runner reads BENCHMARK_* from the environment first; a local
# .env.benchmark.local file is loaded only if present (see benchmarks/run.mjs).

# Target host for the benchmark run (local server spawned by the runner by default)
BENCHMARK_BASE_URL=http://127.0.0.1:4100

# Dedicated benchmark test account (NOT a production credential).
# The runner registers/logs in with these via /api/auth/* and uses the
# returned JWT for auth-protected routes. No production token is required.
BENCHMARK_EMAIL=bench@example.com
BENCHMARK_PASSWORD=Benchmark-123

# Full-run load shape (smoke mode overrides these with minimal values).
# Keep requests*endpoints under the API rate limiter (200 req / 15 min window):
# 21 endpoints x 8 = 168 requests.
BENCHMARK_REQUESTS_PER_ENDPOINT=8
BENCHMARK_CONCURRENCY=4
