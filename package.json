{
  "name": "freelance-platform-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "echo \"Run package-specific builds (e.g. npm run build -w apps/web)\"",
    "lint": "echo \"No root lint configured\"",
    "test": "npm run test -w apps/api && npm run benchmark:test",
    "benchmark": "node --env-file-if-exists=.env.benchmark benchmarks/run.mjs",
    "benchmark:smoke": "node --env-file-if-exists=.env.benchmark benchmarks/run.mjs --smoke",
    "benchmark:test": "node --test benchmarks/tests/*.test.mjs"
  }
}
