{
  "name": "freelance-platform-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "echo \"Run package-specific builds (e.g. npm run build -w apps/web)\"",
    "lint": "echo \"No root lint configured\"",
    "test": "npm run test -w apps/api",
    "detect": "node scripts/detect-issues.mjs",
    "detect:report": "node scripts/detect-issues.mjs --json",
    "detect:issues": "node scripts/create-issues.mjs --dry-run --repo bug-bounty/bug-bounty"
  }
}
